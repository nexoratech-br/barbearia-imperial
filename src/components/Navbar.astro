<nav class="fixed top-0 left-0 w-full z-50 bg-black/70 backdrop-blur-md">
	<div class="max-w-7xl mx-auto px-6 py-5 flex items-center justify-between">
		<a href="#inicio" class="text-white font-bold text-lg">
			IMPERIAL
		</a>

		<div class="hidden md:flex items-center gap-8 text-sm">
			<a href="#servicos" class="text-gray-200 hover:text-yellow-500 transition">
				Serviços
			</a>

			<a href="#sobre" class="text-gray-200 hover:text-yellow-500 transition">
				Sobre
			</a>

			<a href="#galeria" class="text-gray-200 hover:text-yellow-500 transition">
				Galeria
			</a>

			<a href="#contato" class="text-gray-200 hover:text-yellow-500 transition">
				Contato
			</a>
		</div>

		<button id="menu-btn" class="md:hidden text-white text-2xl cursor-pointer" aria-label="Abrir menu">
			☰
		</button>
	</div>

	<div id="mobile-menu" class="hidden md:hidden flex-col gap-5 px-6 py-6 text-sm bg-black/95 border-t border-white/10">
		<a href="#servicos" class="text-gray-200 hover:text-yellow-500 transition">
			Serviços
		</a>

		<a href="#sobre" class="text-gray-200 hover:text-yellow-500 transition">
			Sobre
		</a>

		<a href="#galeria" class="text-gray-200 hover:text-yellow-500 transition">
			Galeria
		</a>

		<a href="#contato" class="text-gray-200 hover:text-yellow-500 transition">
			Contato
		</a>
	</div>
</nav>

<script>
	const menuBtn = document.getElementById("menu-btn");
	const mobileMenu = document.getElementById("mobile-menu");
	const menuLinks = mobileMenu?.querySelectorAll("a");

	menuBtn?.addEventListener("click", () => {
		mobileMenu?.classList.toggle("hidden");
		mobileMenu?.classList.toggle("flex");

		const menuAberto = !mobileMenu?.classList.contains("hidden");

		menuBtn.textContent = menuAberto ? "✕" : "☰";
	});

	menuLinks?.forEach((link) => {
		link.addEventListener("click", () => {
			mobileMenu?.classList.add("hidden");
			mobileMenu?.classList.remove("flex");

			if (menuBtn) {
				menuBtn.textContent = "☰";
			}
		});
	});
</script>