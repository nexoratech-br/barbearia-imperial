---
const services = [
  {name:'Corte', description:'Forma, proporção e acabamento. Um corte que respeita seu estilo.', price:'45'},
  {name:'Barba', description:'Desenho definido e alinhamento para valorizar o seu rosto.', price:'35'},
  {name:'Corte + Barba', description:'O cuidado completo. Cabelo e barba em perfeita sintonia.', price:'70'},
  {name:'Acabamento', description:'Os ajustes que fazem a diferença e mantêm o visual em dia.', price:'25'},
];
---
<section id="servicos" class="services section-pad">
  <div class="container"><div class="section-heading" data-reveal><div><p class="eyebrow">02 — SERVIÇOS</p><h2>Precisão que<br/>faz <span class="serif-accent">diferença.</span></h2></div><p class="section-description">Do visual de sempre a uma nova versão de você. Escolha o seu cuidado.</p></div>
    <div class="services-grid"><figure class="services-image" data-reveal><img src="/images/Gallery-image-2.webp" srcset="/images/Gallery-image-2-700.webp 700w, /images/Gallery-image-2.webp 1122w" sizes="(max-width: 599px) 100vw, 50vw" alt="Tesoura, navalha e instrumentos de barbearia sobre a bancada" width="1122" height="1402" loading="lazy" decoding="async"/><figcaption><span>O ESSENCIAL, BEM FEITO.</span><span>IMPERIAL / CUIDADO MASCULINO</span></figcaption></figure>
    <div class="service-list" data-reveal>{services.map((service, i) => <a class="service-row" href="#contato" aria-label={service.name + ' — R$ ' + service.price + '. Agendar horário'}><span class="service-number">0{i + 1}</span><div class="service-info"><h3>{service.name}</h3><p>{service.description}</p></div><div class="service-price"><span>R$</span> {service.price}</div></a>)}<p class="service-note">Seu próximo visual começa com uma conversa.<a href="#contato">Vamos agendar</a></p></div></div>
  </div>
</section>
